# SUPABASE_URL: Required. The API endpoint URL of your Supabase project.
SUPABASE_URL="https://your-project-id.supabase.co"

# SUPABASE_SERVICE_ROLE_KEY: Required. Service role API key to authenticate admin CRUD and signed upload URLs.
# Keep this secret. Do not expose this key on the client side.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ADMIN_PIN: Required. PIN password string for admin panel authentication (defaults to admin123).
ADMIN_PIN="admin123"

# GEMINI_API_KEY: Optional. Setup for Gemini AI functionalities (if configured).
GEMINI_API_KEY=""

# APP_URL: Optional. Base canonical URL of the deployed application.
APP_URL=""
